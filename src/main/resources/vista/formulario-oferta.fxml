<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="candidaturas.controlador.FormularioOfertaController"
      spacing="12.0" prefWidth="520.0" styleClass="contenido">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <Label fx:id="lblTitulo" text="Nueva candidatura" styleClass="titulo"/>

    <Label text="La oportunidad" styleClass="subtitulo"/>
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Puesto *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" promptText="Ej: Desarrollador Java" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Empresa *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEmpresa" maxWidth="Infinity" promptText="Elige la empresa"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Salario (€)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSalario" promptText="Ej: 24000" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Enlace" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEnlace" promptText="https://..." GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Descripción" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Sigue el progreso" styleClass="subtitulo"/>
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Estado *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEstado" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Fecha" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Notas" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
    <HBox spacing="8.0" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" cancelButton="true"/>
        <Button text="Guardar" onAction="#guardar" styleClass="boton-principal" defaultButton="true"/>
    </HBox>
</VBox>
