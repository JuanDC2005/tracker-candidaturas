<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="candidaturas.controlador.EmpresasController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>
    <top>
        <VBox spacing="4.0">
            <Label text="Empresas" styleClass="titulo"/>
            <Label text="Directorio de empresas a las que has enviado candidaturas" styleClass="subtitulo"/>
            <BorderPane.margin>
                <Insets bottom="15.0"/>
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaEmpresas">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180.0"/>
                <TableColumn fx:id="colSector" text="Sector" prefWidth="130.0"/>
                <TableColumn fx:id="colWeb" text="Web" prefWidth="200.0"/>
                <TableColumn fx:id="colFecha" text="Registro" prefWidth="100.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
    <right>
        <VBox spacing="8.0" prefWidth="260.0" styleClass="tarjeta">
            <BorderPane.margin>
                <Insets left="15.0"/>
            </BorderPane.margin>
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>
            <Label fx:id="lblFormulario" text="Nueva empresa" styleClass="subtitulo"/>
            <Label text="Nombre *"/>
            <TextField fx:id="txtNombre" promptText="Ej: Indra"/>
            <Label text="Sector"/>
            <ComboBox fx:id="cbSector" editable="true" maxWidth="Infinity" promptText="Elige o escribe"/>
            <Label text="Web"/>
            <TextField fx:id="txtWeb" promptText="https://..."/>
            <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>
            <HBox spacing="8.0">
                <Button text="Nuevo" onAction="#nuevo"/>
                <Button text="Guardar" onAction="#guardar" styleClass="boton-principal" defaultButton="true"/>
            </HBox>
            <Button fx:id="btnBorrar" text="Borrar empresa" onAction="#borrar" styleClass="boton-peligro"
                    maxWidth="Infinity" disable="true"/>
        </VBox>
    </right>
</BorderPane>
